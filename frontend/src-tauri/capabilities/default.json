{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop app permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/resumecr7-backend",
          "sidecar": true,
          "args": [
            "--host",
            {
              "validator": "^127\\.0\\.0\\.1$"
            },
            "--port",
            {
              "validator": "^[0-9]+$"
            },
            "--packaged",
            "--data-dir",
            {
              "validator": "^.+$"
            }
          ]
        }
      ]
    }
  ]
}
