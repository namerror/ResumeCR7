{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ResumeCR7",
  "version": "0.1.3",
  "identifier": "com.resumecr7.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ResumeCR7",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first resume evidence and generation workbench.",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/resumecr7-backend"]
  }
}
