{
  "name": "resumecr7-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "sidecar:build": "uv run --project .. --extra desktop python ../scripts/build_desktop_sidecar.py",
    "desktop:dev": "npm run sidecar:build && tauri dev",
    "desktop:build": "npm run sidecar:build && tauri build",
    "desktop:build:linux": "npm run sidecar:build && tauri build --bundles appimage",
    "desktop:build:windows": "npm run sidecar:build -- --target-triple x86_64-pc-windows-msvc && tauri build --bundles nsis",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
